# Copy this file to ``.env`` in the same folder (project root: jk_erp) and fill in values.
# ``.env`` is gitignored — do not commit real passwords.

# --- Dev server ---
# Port 8000 is often used by RTOM v2 on this machine. Run JK ERP with:
#   run_jk_erp.bat
# or:  python manage.py runserver 127.0.0.1:8010

# --- PostgreSQL (example; match your install) ---
# POSTGRES_DB=jk_erp
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433

# --- Zoho Mail SMTP (smtppro.zoho.com) — Django default mail ---
# Used when code calls Django's mail API without a custom connection, and for
#   python manage.py sendtestemail
# Engagement team assignment emails instead use: Setup → Mail (stored in Postgres).

EMAIL_HOST=smtppro.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-mailbox@yourdomain.com
EMAIL_HOST_PASSWORD=your-zoho-app-specific-password
DEFAULT_FROM_EMAIL=your-mailbox@yourdomain.com
# SERVER_EMAIL=your-mailbox@yourdomain.com
# EMAIL_TIMEOUT=30

# Zoho on port 465 (SSL): set TLS off and SSL on (or omit TLS/SSL vars — settings infer SSL for 465).
# EMAIL_PORT=465
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=true
