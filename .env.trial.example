# Copy to ``.env.trial`` in the project root (alongside ``.env``).
# Loaded automatically when JK_ERP_ENV=trial (see run_jk_erp_trial.bat).
# Values here override the same keys from ``.env`` — only set trial-specific keys.

JK_ERP_ENV=trial
TRIAL_ALLOWED_USERNAME=srini

# Separate database from production (required)
POSTGRES_DB=jk_erp_trial

# Postgres user/host/password/port are inherited from ``.env`` unless you override them here.

# Optional: keep uploads separate from production
# MEDIA_ROOT_DIR=media_trial

# Trial server is for sample data — debug on is fine locally
# DJANGO_DEBUG=true

# --- Dev server ---
# Trial:  run_jk_erp_trial.bat  →  http://127.0.0.1:8011/
# Production:  run_jk_erp.bat  →  http://127.0.0.1:8010/
